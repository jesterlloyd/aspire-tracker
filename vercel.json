{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/teams-invite-reminders",
      "schedule": "0 15 * * 1-5"
    }
  ],
  "functions": {
    "api/keith.js":                       { "maxDuration": 30 },
    "api/invite-user.js":                 { "maxDuration": 10 },
    "api/manage-interviewers.js":         { "maxDuration": 10 },
    "api/availability.js":                { "maxDuration": 15 },
    "api/interview-lookup.js":            { "maxDuration": 10 },
    "api/interview-book.js":              { "maxDuration": 10 },
    "api/student-update.js":              { "maxDuration": 10 },
    "api/admin-users.js":                 { "maxDuration": 10 },
    "api/unit-form-notification.js":      { "maxDuration": 15 },
    "api/cron/teams-invite-reminders.js": { "maxDuration": 60 }
  }
}

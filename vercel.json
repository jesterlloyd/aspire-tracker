{
  "rewrites": [
    {
      "source": "/((?!api/).*)",
      "destination": "/app.html"
    }
  ],
  "headers": [
    {
      "source": "/login",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/portal/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/portal",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/auth/:path*",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/app.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }]
    }
  ],
  "crons": [
    {
      "path": "/api/cron/teams-invite-reminders",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/cron/interview-reminders",
      "schedule": "0 17 * * *"
    },
    {
      "path": "/api/cron/student-birthday-greetings",
      "schedule": "0 16,17,18 * * *"
    },
    {
      "path": "/api/cron/cohort-access-retirement",
      "schedule": "0 16,17,18 * * *"
    },
    {
      "path": "/api/cron/coordinator-weekly-digest",
      "schedule": "0 16 * * 5"
    },
    {
      "path": "/api/cron/evaluation-reminders",
      "schedule": "0 16 * * 2"
    },
    {
      "path": "/api/cron/evaluation-reminders-recovery",
      "schedule": "30 * * * *"
    },
    {
      "path": "/api/cron/midpoint-checkin",
      "schedule": "0 15 * * *"
    },
    {
      "path": "/api/cron/student-completion-reconciliation",
      "schedule": "5 13 * * *"
    },
    {
      "path": "/api/cron/clockout-reminders-scheduled",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/messages-delivery-worker",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/staff-notification-worker",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/cron/portal-feedback-delivery-worker",
      "schedule": "*/10 * * * *"
    }
  ],
  "functions": {
    "api/connect-send-bulk-message.js":   { "maxDuration": 60 },
    "api/keith.js":                       { "maxDuration": 30 },
    "api/knowledge-enrich.js":            { "maxDuration": 300 },
    "api/invite-user.js":                 { "maxDuration": 10 },
    "api/manage-interviewers.js":         { "maxDuration": 10 },
    "api/availability.js":                { "maxDuration": 15 },
    "api/interview-lookup.js":            { "maxDuration": 10 },
    "api/interview-book.js":              { "maxDuration": 10 },
    "api/student-update.js":              { "maxDuration": 10 },
    "api/admin-users.js":                 { "maxDuration": 10 },
    "api/unit-form-submit.js":            { "maxDuration": 15 },
    "api/cron/teams-invite-reminders.js": { "maxDuration": 60 },
    "api/cron/interview-reminders.js":             { "maxDuration": 60 },
    "api/admin/resend-interview-reminders.js":     { "maxDuration": 60 },
    "api/cron/coordinator-weekly-digest.js":       { "maxDuration": 60 },
    "api/cron/evaluation-reminders.js":            { "maxDuration": 300 },
    "api/cron/evaluation-reminders-recovery.js":   { "maxDuration": 300 },
    "api/admin/resend-coordinator-digest.js":      { "maxDuration": 60 },
    "api/school-form-submit.js":                   { "maxDuration": 30 },
    "api/portal/school-placement-requests.js":     { "maxDuration": 30 },
    "api/update-rotation-dates.js":                { "maxDuration": 15 },
    "api/cron/midpoint-checkin.js":                { "maxDuration": 60 },
    "api/cron/student-completion-reconciliation.js": { "maxDuration": 60 },
    "api/cron/clockout-reminders-scheduled.js":    { "maxDuration": 60 },
    "api/cron/messages-delivery-worker.js":        { "maxDuration": 60 },
    "api/cron/staff-notification-worker.js":       { "maxDuration": 60 },
    "api/cron/portal-feedback-delivery-worker.js": { "maxDuration": 60 },
    "api/send-midpoint-checkin.js":                { "maxDuration": 15 },
    "api/evaluation-send-preceptor-invitations.js": { "maxDuration": 60 },
    "api/evaluation-release-preceptor-survey.js":   { "maxDuration": 30 },
    "api/evaluation-release-student-eval-survey.js": { "maxDuration": 30 }
  }
}
